# Copia este archivo como backend/.env y pon tus valores. El archivo .env NUNCA se sube al repositorio.
DB_URL=jdbc:postgresql://localhost:5433/campusdesk
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave
JPA_DDL_AUTO=update
SERVER_PORT=8080
# Secreto JWT: minimo 32 caracteres (256 bits). Cada integrante genera el suyo.
JWT_SECRET=genera_uno_con_openssl_rand_base64_48
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ADMIN_EMAIL=admin@technova.com
ADMIN_PASSWORD=cambia_esta_clave
TECH_PASSWORD=cambia_esta_clave
